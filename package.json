{
  "name": "@moshly/apps-tokens",
  "version": "1.0.0",
  "description": "Moshly design tokens — JSON source of truth (W3C DTCG) with generated CSS, Tailwind themes and a Swift package for iOS",
  "style": "themes/base.css",
  "exports": {
    ".": "./themes/base.css",
    "./themes/base": "./themes/base.css",
    "./themes/forms": "./themes/forms.css",
    "./themes/street": "./themes/street.css",
    "./themes/projects": "./themes/projects.css",
    "./skins/purple": "./skins/purple.css",
    "./skins/red": "./skins/red.css",
    "./skins/cyan": "./skins/cyan.css",
    "./skins/magenta": "./skins/magenta.css",
    "./tokens/colors": "./tokens/colors.css",
    "./neo-brut": "./dist/neo-brut.css",
    "./themes/neo-brut": "./themes/neo-brut.css",
    "./tokens/neo-brut/*": "./tokens/neo-brut/*"
  },
  "keywords": [
    "design-tokens",
    "tailwind",
    "moshly",
    "design-system",
    "apps",
    "themes",
    "skins",
    "neo-brut",
    "dtcg",
    "swiftui",
    "ios"
  ],
  "author": "Moshly",
  "license": "MIT",
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/emptytown/moshly-design-tokens.git"
  },
  "scripts": {
    "build": "node build/build.mjs",
    "check": "node build/build.mjs --check"
  },
  "files": [
    "dist",
    "themes",
    "skins",
    "tokens",
    "build"
  ],
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
